#. Description of the plugin
#: coupon_creator.php
msgid ""
"Designed, printable coupons for WordPress. Put a real coupon on your site."
msgstr ""
"Des coupons stylisés et imprimables pour WordPress. Mettez un vrai coupon "
"sur votre site."

#. Author of the plugin
#: coupon_creator.php
msgid "Artifex Routing Co"
msgstr "Artifex Routing Co"

#. Author URI of the plugin
